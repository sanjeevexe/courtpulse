{
  "uid": "courtpulse-local",
  "title": "CourtPulse operations",
  "tags": [
    "courtpulse",
    "local"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"courtpulse-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Live feed freshness (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_feed_freshness_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Oldest unprocessed event (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_event_oldest_unprocessed_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox backlog by destination",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_outbox_backlog",
          "legendFormat": "{{destination}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Queue and DLQ depth",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Blocked reconciliations",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_reconciliation_blocked",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Delivery retries and terminal failures",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_delivery_retries",
          "legendFormat": "retry",
          "refId": "A"
        },
        {
          "expr": "courtpulse_delivery_terminal_failures",
          "legendFormat": "terminal",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Worker heartbeat age (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 14,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_worker_heartbeat_age_seconds",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Provider requests and throttling (per minute)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "rate(courtpulse_provider_requests[5m]) * 60",
          "legendFormat": "requests",
          "refId": "A"
        },
        {
          "expr": "rate(courtpulse_provider_rate_limited[5m]) * 60",
          "legendFormat": "429 responses",
          "refId": "B"
        },
        {
          "expr": "rate(courtpulse_provider_failures[5m]) * 60",
          "legendFormat": "failures",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "title": "Provider games by lifecycle",
      "type": "timeseries",
      "gridPos": {
        "x": 9,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_provider_games",
          "legendFormat": "{{lifecycle}}",
          "refId": "A"
        },
        {
          "expr": "courtpulse_provider_circuit_open",
          "legendFormat": "circuit open",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Provider data-quality incidents",
      "type": "stat",
      "gridPos": {
        "x": 17,
        "y": 21,
        "w": 7,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "courtpulse-prometheus"
      },
      "targets": [
        {
          "expr": "courtpulse_provider_data_incidents",
          "legendFormat": "incidents",
          "refId": "A"
        }
      ]
    }
  ]
}
