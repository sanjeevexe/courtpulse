# Local OIDC profile. Supply non-production values in an untracked .env file or shell.
COURTPULSE_IDP_ADMIN_USERNAME=
COURTPULSE_IDP_ADMIN_PASSWORD=
COURTPULSE_TEST_USER_A=
COURTPULSE_TEST_USER_A_PASSWORD=
COURTPULSE_TEST_USER_B=
COURTPULSE_TEST_USER_B_PASSWORD=
COURTPULSE_TEST_OPS_USER=
COURTPULSE_TEST_OPS_PASSWORD=

COURTPULSE_AUTH_ENABLED=true
COURTPULSE_AUTH_ISSUER_BASE=http://127.0.0.1:8180
COURTPULSE_AUTH_ISSUER_URI=http://127.0.0.1:8180/realms/courtpulse
# Browser-visible origin used only to build the web Content-Security-Policy.
COURTPULSE_AUTH_ISSUER_ORIGIN=http://127.0.0.1:8180
COURTPULSE_AUTH_JWK_SET_URI=http://identity:8080/realms/courtpulse/protocol/openid-connect/certs
COURTPULSE_AUTH_AUDIENCE=courtpulse-api
COURTPULSE_AUTH_CLIENT_ID=courtpulse-web
COURTPULSE_AUTH_BROWSER_SCOPE=openid profile
COURTPULSE_AUTH_AUTHORITIES_CLAIM=courtpulse_roles
COURTPULSE_AUTH_AUTHORITY_PREFIX=ROLE_
COURTPULSE_AUTH_OPERATIONS_AUTHORITY=ROLE_courtpulse:ops
